{
  "_template": true,
  "_note": "Copy this file to examples/<client-slug>/design-dna.json and replace every {{PLACEHOLDER}} with evidence-backed values. Delete keys that begin with an underscore. Do not keep a value that no citation supports.",
  "$schema": "https://premium-web-dna.local/schemas/design-dna.schema.json",
  "schema_version": "1.0",
  "framework": "DNA Audit Framework v1",
  "framework_version": "1.0.0",
  "meta": {
    "name": "{{CLIENT_NAME}}",
    "slug": "{{client-slug}}",
    "version": "1.0.0",
    "audited_at": "{{YYYY-MM-DD}}",
    "source": "{{REPOSITORY_OR_URL}}",
    "source_commit": "{{COMMIT_OR_CAPTURE_TIMESTAMP}}",
    "auditor": "{{AUDITOR}}",
    "confidence": 0,
    "licence": "{{LICENCE_OR_PERMISSION_SCOPE}}",
    "restrictions": [
      "{{RESTRICTION}}"
    ]
  },
  "archetype": {
    "primary": "{{PRIMARY_ARCHETYPE}}",
    "secondary": "{{SECONDARY_ARCHETYPE}}",
    "tertiary": "{{TERTIARY_ARCHETYPE}}",
    "confidence": 0,
    "scores": {
      "{{ARCHETYPE}}": 0
    },
    "evidence": [
      "{{FILE}}:{{LINE}} {{EVIDENCE}}"
    ]
  },
  "fingerprint": {
    "archetype": "{{PRIMARY_ARCHETYPE}}-{{SECONDARY_ARCHETYPE}}",
    "density": "{{compact|balanced|spacious|editorial}}",
    "contrast": "{{low|medium|high|extreme}}",
    "motion_style": "{{static|subtle|smooth|cinematic|expressive}}",
    "cta_style": "{{direct|confidence-based|consultative|urgency|minimal}}",
    "card_style": "{{flat|bordered|elevated|editorial|immersive}}",
    "navbar_style": "{{solid|transparent|transparent-blur|minimal|masthead}}"
  },
  "tokens": {
    "colors": {
      "ink": {
        "value": "{{COLOUR}}",
        "role": "Primary text",
        "evidence": [
          "{{FILE}}:{{LINE}}"
        ]
      },
      "surface": {
        "value": "{{COLOUR}}",
        "role": "Primary surface",
        "evidence": [
          "{{FILE}}:{{LINE}}"
        ]
      },
      "accent": {
        "value": "{{COLOUR}}",
        "role": "Action accent",
        "evidence": [
          "{{FILE}}:{{LINE}}"
        ]
      }
    },
    "typography": {
      "families": [
        {
          "name": "{{FONT_FAMILY}}",
          "variable": "{{--font-variable}}",
          "role": "{{display|sans|serif|mono}}"
        }
      ],
      "scale": [
        {
          "name": "{{utility}}",
          "family": "{{FONT_FAMILY}}",
          "size": "{{SIZE}}",
          "line_height": 0,
          "tracking": "{{TRACKING}}",
          "weight": 0,
          "use": "{{USE}}"
        }
      ]
    },
    "spacing": {
      "base": "{{BASE}}",
      "scale": [
        "{{STEP}}"
      ],
      "section": "{{SECTION_PADDING}}",
      "feature": "{{FEATURE_PADDING}}"
    },
    "radii": {
      "default": "{{RADIUS}}",
      "badge": "{{RADIUS}}",
      "media": "{{RADIUS}}"
    },
    "borders": {
      "hairline_light": "{{BORDER}}",
      "hairline_strong": "{{BORDER}}",
      "dark": "{{BORDER}}"
    },
    "shadows": {
      "default": "{{SHADOW}}",
      "interaction": "{{SHADOW}}"
    },
    "motion": {
      "easings": {
        "default": "{{EASING}}"
      },
      "durations": {
        "quick": "{{DURATION}}",
        "base": "{{DURATION}}",
        "slow": "{{DURATION}}"
      },
      "exceptions": {}
    },
    "breakpoints": {
      "sm": "{{BREAKPOINT}}",
      "md": "{{BREAKPOINT}}",
      "lg": "{{BREAKPOINT}}",
      "xl": "{{BREAKPOINT}}"
    },
    "z_index": {
      "header": 0,
      "overlay": 0,
      "dialog": 0
    }
  },
  "surfaces": [
    {
      "name": "{{SURFACE_NAME}}",
      "token": "{{COLOUR_TOKEN}}",
      "text_token": "{{COLOUR_TOKEN}}",
      "role": "{{NARRATIVE_ROLE}}"
    }
  ],
  "components": [
    {
      "id": "{{component-id}}",
      "component": "{{ComponentName}}",
      "variant": "{{variant}}",
      "confidence": 0,
      "evidence": [
        "{{FILE}}:{{LINE}}"
      ],
      "anatomy": [
        "{{part}}"
      ],
      "states": [
        "{{state}}"
      ],
      "responsive": "{{RESPONSIVE_BEHAVIOUR}}",
      "tokens": [
        "{{TOKEN}}"
      ],
      "accessibility": "{{ACCESSIBILITY_NOTES}}",
      "motion": "{{MOTION_NOTES}}"
    }
  ],
  "pages": [
    {
      "type": "{{page-type}}",
      "sections": [
        "{{section}}"
      ],
      "rules": [
        "{{RULE}}"
      ]
    }
  ],
  "rules": {
    "do": [
      "{{DO_RULE}}"
    ],
    "dont": [
      "{{DONT_RULE}}"
    ],
    "max_font_families": 0,
    "accent_budget_per_viewport": 0,
    "corner_radius": "{{RADIUS}}",
    "motion_easing": "{{EASING}}",
    "hero": {
      "preferred_variant": "{{variant}}",
      "headline_length": "{{HEADLINE_LENGTH}}",
      "cta_count": 0
    }
  },
  "accessibility": {
    "wcag_level": "{{A|AA|AAA}}",
    "issues": [
      {
        "id": "{{issue-id}}",
        "severity": "{{P0|P1|P2|P3}}",
        "category": "{{CATEGORY}}",
        "finding": "{{FINDING}}",
        "evidence": "{{FILE}}:{{LINE}}",
        "status": "{{open|resolved|accepted}}"
      }
    ],
    "contrast_pairs": [
      {
        "foreground": "{{COLOUR}}",
        "background": "{{COLOUR}}",
        "context": "{{WHERE_USED}}",
        "ratio": 0,
        "level": "{{AA|AAA|fail}}"
      }
    ]
  },
  "scores": {
    "framework": "DNA Audit Framework v1",
    "framework_version": "1.0.0",
    "total": 0,
    "band": "{{Exceptional|Premium|Professional|Functional|Weak}}",
    "categories": {
      "visual_system": {
        "max": 20,
        "score": 0,
        "note": "{{EVIDENCE_BACKED_DEDUCTION}}"
      },
      "ux_architecture": {
        "max": 15,
        "score": 0,
        "note": "{{EVIDENCE_BACKED_DEDUCTION}}"
      },
      "typography": {
        "max": 10,
        "score": 0,
        "note": "{{EVIDENCE_BACKED_DEDUCTION}}"
      },
      "spacing": {
        "max": 10,
        "score": 0,
        "note": "{{EVIDENCE_BACKED_DEDUCTION}}"
      },
      "brand_distinction": {
        "max": 10,
        "score": 0,
        "note": "{{EVIDENCE_BACKED_DEDUCTION}}"
      },
      "trust_signals": {
        "max": 10,
        "score": 0,
        "note": "{{EVIDENCE_BACKED_DEDUCTION}}"
      },
      "motion": {
        "max": 10,
        "score": 0,
        "note": "{{EVIDENCE_BACKED_DEDUCTION}}"
      },
      "accessibility": {
        "max": 5,
        "score": 0,
        "note": "{{EVIDENCE_BACKED_DEDUCTION}}"
      },
      "performance": {
        "max": 5,
        "score": 0,
        "note": "{{EVIDENCE_BACKED_DEDUCTION}}"
      },
      "content_quality": {
        "max": 5,
        "score": 0,
        "note": "{{EVIDENCE_BACKED_DEDUCTION}}"
      }
    }
  },
  "provenance": {
    "source": "{{REPOSITORY_OR_URL}}",
    "source_commit": "{{COMMIT_OR_CAPTURE_TIMESTAMP}}",
    "audit_date": "{{YYYY-MM-DD}}",
    "auditor": "{{AUDITOR}}",
    "licence": "{{LICENCE_OR_PERMISSION_SCOPE}}",
    "restrictions": [
      "{{RESTRICTION}}"
    ],
    "evidence_count": 0,
    "status": "{{audit-complete|blocked}}",
    "publication_blockers": [
      "{{P0_BLOCKER_OR_DELETE_THIS_ENTRY}}"
    ],
    "notes": "{{KNOWN_GAPS_AND_LIMITS}}"
  }
}
